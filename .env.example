# Copy this file to .env and choose a private staff PIN before starting the app.
STAFF_PIN=replace-with-a-private-pin

# Optional: MongoDB Atlas connection string. Leave unset for in-memory demo data.
MONGODB_URI=

# Optional: frontend origin for cross-origin API access during local development.
APP_ORIGIN=http://localhost:5173

# Optional server bind settings. Defaults are local-only.
HOST=127.0.0.1
PORT=4000
